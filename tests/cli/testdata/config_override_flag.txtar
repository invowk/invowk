# Test: --ivk-config flag for custom config path
# Verifies that --ivk-config loads configuration from a custom file path,
# and that config settings (like default_runtime) take effect.
# Note: default config has default_runtime: "native".

cd $WORK

# Test 1: without --ivk-config, command uses default config (native runtime)
exec invowk cmd multi-runtime
stdout 'RUNTIME=native'
! stderr .

# Test 2: with --ivk-config pointing to a config that sets default_runtime: "virtual-sh",
# the command should use the virtual-sh runtime
exec invowk cmd multi-runtime --ivk-config custom-config/config.cue
stdout 'RUNTIME=virtual'
! stderr .

# Test 3: --ivk-config with short form -c
exec invowk cmd multi-runtime -c custom-config/config.cue
stdout 'RUNTIME=virtual'
! stderr .

# Test 4: --ivk-config with a non-existent file fails closed: exit 1, the
# error names the file and the flag, and the command does not run.
! exec invowk cmd multi-runtime --ivk-config nonexistent.cue
! stdout 'RUNTIME='
stderr 'nonexistent.cue'
stderr 'ivk-config'

# Test 5: --ivk-config with invalid CUE also fails closed.
! exec invowk cmd multi-runtime --ivk-config broken-config/config.cue
! stdout 'RUNTIME='
stderr 'ivk-config'

-- invowkfile.cue --
cmds: [
	{
		name:        "multi-runtime"
		description: "Command with both virtual and native implementations"
		implementations: [
			{
				script: {content: "echo 'RUNTIME=virtual'"}
				runtimes:  [{name: "virtual-sh"}]
				platforms: [{name: "linux"}, {name: "macos"}, {name: "windows"}]
			},
			{
				script: {content: "echo 'RUNTIME=native'"}
				runtimes:  [{name: "native"}]
				platforms: [{name: "linux"}, {name: "macos"}]
			},
			{
				script: {content: "Write-Output 'RUNTIME=native'"}
				runtimes:  [{name: "native"}]
				platforms: [{name: "windows"}]
			},
		]
	},
]

-- custom-config/config.cue --
default_runtime: "virtual-sh"

-- broken-config/config.cue --
this is not valid CUE {{{
