# Test: U-root text processing utilities (head, tail, wc, grep, sort, uniq)
# Tests the built-in u-root text utilities in virtual-sh runtime

cd $WORK

# Test: Combined text operations
exec invowk cmd 'uroot text ops'
stdout '=== Testing head ==='
stdout 'line 1'
stdout 'line 3'
stdout '=== Testing tail ==='
stdout 'line 4'
stdout 'line 5'
stdout '=== Testing wc ==='
stdout '5'
stdout '=== Testing grep ==='
stdout 'apple'
stdout '=== Testing sort ==='
stdout 'apple'
stdout '=== Testing sort | uniq ==='
stdout 'apple'
stdout 'banana'
stdout 'cherry'
stdout '=== uroot text ops test complete ==='
! stderr .

-- invowkfile.cue --
cmds: [
	{
		name:        "uroot text ops"
		description: "Test u-root text processing operations"
		implementations: [{
			script: {content: """
				# Setup test files
				mkdir -p "$WORK/invowk-uroot-textops"

				# Create test file with lines
				echo 'line 1' > "$WORK/invowk-uroot-textops/lines.txt"
				echo 'line 2' >> "$WORK/invowk-uroot-textops/lines.txt"
				echo 'line 3' >> "$WORK/invowk-uroot-textops/lines.txt"
				echo 'line 4' >> "$WORK/invowk-uroot-textops/lines.txt"
				echo 'line 5' >> "$WORK/invowk-uroot-textops/lines.txt"

				# Create test file with fruits
				echo 'cherry' > "$WORK/invowk-uroot-textops/fruits.txt"
				echo 'apple' >> "$WORK/invowk-uroot-textops/fruits.txt"
				echo 'banana' >> "$WORK/invowk-uroot-textops/fruits.txt"
				echo 'apple' >> "$WORK/invowk-uroot-textops/fruits.txt"
				echo 'cherry' >> "$WORK/invowk-uroot-textops/fruits.txt"

				# Test head
				echo '=== Testing head ==='
				head -n 3 "$WORK/invowk-uroot-textops/lines.txt"

				# Test tail
				echo '=== Testing tail ==='
				tail -n 2 "$WORK/invowk-uroot-textops/lines.txt"

				# Test wc
				echo '=== Testing wc ==='
				wc -l "$WORK/invowk-uroot-textops/lines.txt"

				# Test grep
				echo '=== Testing grep ==='
				grep apple "$WORK/invowk-uroot-textops/fruits.txt"

				# Test sort
				echo '=== Testing sort ==='
				sort "$WORK/invowk-uroot-textops/fruits.txt"

				# Test sort | uniq
				echo '=== Testing sort | uniq ==='
				sort "$WORK/invowk-uroot-textops/fruits.txt" | uniq

				# Cleanup
				rm -rf "$WORK/invowk-uroot-textops"

				echo '=== uroot text ops test complete ==='
				"""}
			runtimes: [{name: "virtual-sh"}]
			platforms: [{name: "linux"}, {name: "macos"}, {name: "windows"}]
		}]
	},
]
