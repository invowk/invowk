# Test: Ambiguous command listing using native runtime (User Story 3)
# Mirrors virtual_ambiguity.txtar but with platform-split native implementations
# Tests that commands with the same name from different sources show disambiguation annotations
# and cannot be executed without explicit source specification

# Change to work directory where the test files will be created
cd $WORK

# Test 1: List commands - ambiguous commands should show source annotation
# The "deploy" command exists in both invowkfile and foo.invowkmod
exec invowk cmd
stdout 'From invowkfile:'
stdout 'hello'
stdout 'deploy.*@invowkfile'
stdout 'From foo.invowkmod:'
stdout 'build'
stdout 'deploy.*@foo'
! stderr .

# Test 2: Unambiguous commands should NOT show source annotation
# "hello" only exists in invowkfile, "build" only exists in foo
exec invowk cmd
! stdout 'hello.*@'
! stdout 'build.*@'

# Test 3: running the top-level ambiguous name without a source exits 2
exitcode 2 invowk cmd deploy
! stdout .
stderr 'Ambiguous command'

# Test 4: an ambiguous nested name reached through an unambiguous group node
# ("release dev" is unique, so group node "release" is registered) exits 2
exitcode 2 invowk cmd release prod
! stdout .
stderr 'Ambiguous command'
stderr 'release prod'

# Test 5: the same nested name with --ivk-from runs the invowkfile's command
exitcode 0 invowk cmd release prod --ivk-from invowkfile
stdout 'Releasing prod from invowkfile!'

# Test 6: the unique sibling still runs through the group node
exitcode 0 invowk cmd release dev
stdout 'Releasing dev from invowkfile!'

-- invowkfile.cue --
cmds: [
	{
		name:        "hello"
		description: "Hello from root invowkfile"
		implementations: [
			{
				script: {content: "echo 'Hello from root!'"}
				runtimes:  [{name: "native"}]
				platforms: [{name: "linux"}, {name: "macos"}]
			},
			{
				script: {content: "Write-Output 'Hello from root!'"}
				runtimes:  [{name: "native"}]
				platforms: [{name: "windows"}]
			},
		]
	},
	{
		name:        "deploy"
		description: "Deploy from root invowkfile"
		implementations: [
			{
				script: {content: "echo 'Deploying from invowkfile!'"}
				runtimes:  [{name: "native"}]
				platforms: [{name: "linux"}, {name: "macos"}]
			},
			{
				script: {content: "Write-Output 'Deploying from invowkfile!'"}
				runtimes:  [{name: "native"}]
				platforms: [{name: "windows"}]
			},
		]
	},
	{
		name:        "release prod"
		description: "Release prod from root invowkfile"
		implementations: [
			{
				script: {content: "echo 'Releasing prod from invowkfile!'"}
				runtimes:  [{name: "native"}]
				platforms: [{name: "linux"}, {name: "macos"}]
			},
			{
				script: {content: "Write-Output 'Releasing prod from invowkfile!'"}
				runtimes:  [{name: "native"}]
				platforms: [{name: "windows"}]
			},
		]
	},
	{
		name:        "release dev"
		description: "Release dev from root invowkfile"
		implementations: [
			{
				script: {content: "echo 'Releasing dev from invowkfile!'"}
				runtimes:  [{name: "native"}]
				platforms: [{name: "linux"}, {name: "macos"}]
			},
			{
				script: {content: "Write-Output 'Releasing dev from invowkfile!'"}
				runtimes:  [{name: "native"}]
				platforms: [{name: "windows"}]
			},
		]
	},
]

-- foo.invowkmod/invowkmod.cue --
module: "foo"
version: "1.0.0"
description: "Foo module"

-- foo.invowkmod/invowkfile.cue --
cmds: [
	{
		name:        "build"
		description: "Build from foo module"
		implementations: [
			{
				script: {content: "echo 'Building from foo!'"}
				runtimes:  [{name: "native"}]
				platforms: [{name: "linux"}, {name: "macos"}]
			},
			{
				script: {content: "Write-Output 'Building from foo!'"}
				runtimes:  [{name: "native"}]
				platforms: [{name: "windows"}]
			},
		]
	},
	{
		name:        "deploy"
		description: "Deploy from foo module"
		implementations: [
			{
				script: {content: "echo 'Deploying from foo!'"}
				runtimes:  [{name: "native"}]
				platforms: [{name: "linux"}, {name: "macos"}]
			},
			{
				script: {content: "Write-Output 'Deploying from foo!'"}
				runtimes:  [{name: "native"}]
				platforms: [{name: "windows"}]
			},
		]
	},
	{
		name:        "release prod"
		description: "Release prod from foo module"
		implementations: [
			{
				script: {content: "echo 'Releasing prod from foo!'"}
				runtimes:  [{name: "native"}]
				platforms: [{name: "linux"}, {name: "macos"}]
			},
			{
				script: {content: "Write-Output 'Releasing prod from foo!'"}
				runtimes:  [{name: "native"}]
				platforms: [{name: "windows"}]
			},
		]
	},
]
