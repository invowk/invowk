# Test: Multi-source command discovery using native runtime (User Story 1 + User Story 2)
# Mirrors virtual_multi_source.txtar but with platform-split native implementations
# Tests that invowk cmd discovers commands from both invowkfile.cue AND sibling modules
# Tests that unambiguous commands execute with simple names (transparent namespace)

# Change to work directory where the test files will be created
cd $WORK

# Test 1: List commands - should show commands grouped by source
# Commands are displayed with their SimpleName (no module prefix)
exec invowk cmd
stdout 'From invowkfile:'
stdout 'hello'
stdout 'From foo.invowkmod:'
stdout 'build'
stdout 'From bar.invowkmod:'
stdout 'test'
! stderr .

# Test 2: Run unambiguous command from invowkfile using simple name
exec invowk cmd hello
stdout 'Hello from root!'
! stderr .

# Test 3 (US2): Run unambiguous command from module using SIMPLE name (no prefix)
# Transparent namespace: "build" is unique, so it works without "foo" prefix
exec invowk cmd build
stdout 'Building from foo!'
! stderr .

# Test 4 (US2): Run another unambiguous module command using simple name
# Transparent namespace: "test" is unique, so it works without "bar" prefix
exec invowk cmd test
stdout 'Testing from bar!'
! stderr .

# Test 5: a command that is also another source's group prefix stays runnable
# (invowkfile leaf "w2", module child "w2 sub"; "m w2 sub" sorts before "w2")
cd prefixleaf
exec invowk cmd w2
stdout 'w2 leaf from invowkfile!'
! stderr .
exec invowk cmd w2 sub
stdout 'w2 sub from m!'
! stderr .

# Test 6: the listing shows the invowkfile first, then the module, and within
# each source lists commands alphabetically by full name, whatever the
# declaration order (zeta, w2, alpha in the invowkfile; w2 sub, beta in m)
exec invowk cmd
stdout '(?s)From invowkfile:.*alpha.*First by name.*w2.*Leaf w2 from root invowkfile.*zeta.*Last by name.*From m\.invowkmod:.*beta.*Module first by name.*w2 sub.*Child w2 sub from m module'
! stderr .
cd $WORK

-- invowkfile.cue --
cmds: [
	{
		name:        "hello"
		description: "Hello from root invowkfile"
		implementations: [
			{
				script: {content: "echo 'Hello from root!'"}
				runtimes:  [{name: "native"}]
				platforms: [{name: "linux"}, {name: "macos"}]
			},
			{
				script: {content: "Write-Output 'Hello from root!'"}
				runtimes:  [{name: "native"}]
				platforms: [{name: "windows"}]
			},
		]
	},
]

-- foo.invowkmod/invowkmod.cue --
module: "foo"
version: "1.0.0"
description: "Foo module"

-- foo.invowkmod/invowkfile.cue --
cmds: [
	{
		name:        "build"
		description: "Build from foo module"
		implementations: [
			{
				script: {content: "echo 'Building from foo!'"}
				runtimes:  [{name: "native"}]
				platforms: [{name: "linux"}, {name: "macos"}]
			},
			{
				script: {content: "Write-Output 'Building from foo!'"}
				runtimes:  [{name: "native"}]
				platforms: [{name: "windows"}]
			},
		]
	},
]

-- bar.invowkmod/invowkmod.cue --
module: "bar"
version: "1.0.0"
description: "Bar module"

-- bar.invowkmod/invowkfile.cue --
cmds: [
	{
		name:        "test"
		description: "Test from bar module"
		implementations: [
			{
				script: {content: "echo 'Testing from bar!'"}
				runtimes:  [{name: "native"}]
				platforms: [{name: "linux"}, {name: "macos"}]
			},
			{
				script: {content: "Write-Output 'Testing from bar!'"}
				runtimes:  [{name: "native"}]
				platforms: [{name: "windows"}]
			},
		]
	},
]

-- prefixleaf/invowkfile.cue --
cmds: [
	{
		name: "zeta"
		description: "Last by name"
		implementations: [
			{script: {content: "echo 'zeta'"}, runtimes: [{name: "native"}], platforms: [{name: "linux"}, {name: "macos"}]},
			{script: {content: "Write-Output 'zeta'"}, runtimes: [{name: "native"}], platforms: [{name: "windows"}]},
		]
	},
	{
		name: "w2"
		description: "Leaf w2 from root invowkfile"
		implementations: [
			{script: {content: "echo 'w2 leaf from invowkfile!'"}, runtimes: [{name: "native"}], platforms: [{name: "linux"}, {name: "macos"}]},
			{script: {content: "Write-Output 'w2 leaf from invowkfile!'"}, runtimes: [{name: "native"}], platforms: [{name: "windows"}]},
		]
	},
	{
		name: "alpha"
		description: "First by name"
		implementations: [
			{script: {content: "echo 'alpha'"}, runtimes: [{name: "native"}], platforms: [{name: "linux"}, {name: "macos"}]},
			{script: {content: "Write-Output 'alpha'"}, runtimes: [{name: "native"}], platforms: [{name: "windows"}]},
		]
	},
]

-- prefixleaf/m.invowkmod/invowkmod.cue --
module: "m"
version: "1.0.0"
description: "M module"

-- prefixleaf/m.invowkmod/invowkfile.cue --
cmds: [
	{
		name: "w2 sub"
		description: "Child w2 sub from m module"
		implementations: [
			{script: {content: "echo 'w2 sub from m!'"}, runtimes: [{name: "native"}], platforms: [{name: "linux"}, {name: "macos"}]},
			{script: {content: "Write-Output 'w2 sub from m!'"}, runtimes: [{name: "native"}], platforms: [{name: "windows"}]},
		]
	},
	{
		name: "beta"
		description: "Module first by name"
		implementations: [
			{script: {content: "echo 'beta'"}, runtimes: [{name: "native"}], platforms: [{name: "linux"}, {name: "macos"}]},
			{script: {content: "Write-Output 'beta'"}, runtimes: [{name: "native"}], platforms: [{name: "windows"}]},
		]
	},
]
