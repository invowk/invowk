# Test: invowk completion generates shell completion scripts
# Tests all four shell types produce expected output and error handling

cd $WORK

# Test 1: Bash completion produces bash completion V2 functions
exec invowk completion bash
stdout 'bash completion V2 for invowk'

# Test 2: Zsh completion produces compdef directive
exec invowk completion zsh
stdout 'compdef'

# Test 3: Fish completion produces fish completion commands
exec invowk completion fish
stdout 'complete -c invowk'

# Test 4: PowerShell completion produces Register-ArgumentCompleter
exec invowk completion powershell
stdout 'Register-ArgumentCompleter'

# Test 5: No args returns error about accepting 1 arg
! exec invowk completion
! stdout .
stderr 'Accepts 1 arg'

# Test 6: Invalid shell type returns error
! exec invowk completion invalid
! stdout .
stderr 'Invalid argument'

# Test 7: __complete for a built-in group lists its subcommands and exits 0
exitcode 0 invowk __complete config ''
stdout '^dump\t'
stdout '^show\tShow current configuration$'
stdout '^:4$'

# Test 8: __complete for discovered commands and a discovered group exits 0
cd comp
exitcode 0 invowk __complete cmd ''
stdout '^a\tCommand a$'
stdout '^test\tCommands under ''test''$'
stdout '^:4$'
exitcode 0 invowk __complete cmd test ''
stdout '^other\tOther tests$'
stdout '^unit\tUnit tests$'
stdout '^:4$'
cd $WORK

# Test 9: __completeNoDesc lists the same names without descriptions
cd comp
exitcode 0 invowk __completeNoDesc cmd ''
stdout '^a$'
stdout '^test$'
stdout '^:4$'
cd $WORK

# Test 10: a leaf that is also another source's group prefix completes with
# its own description, and its child still completes under it
cd prefixleaf
exitcode 0 invowk __complete cmd ''
stdout '^w2\tLeaf w2 from the invowkfile$'
stdout '^:4$'
exitcode 0 invowk __complete cmd w2 ''
stdout '^sub\t'
stdout '^:4$'
cd $WORK

-- comp/invowkfile.cue --
cmds: [
	{name: "a", description: "Command a", implementations: [{script: {content: "echo a"}, runtimes: [{name: "virtual-sh"}], platforms: [{name: "linux"}, {name: "macos"}, {name: "windows"}]}]},
	{name: "test unit", description: "Unit tests", implementations: [{script: {content: "echo unit"}, runtimes: [{name: "virtual-sh"}], platforms: [{name: "linux"}, {name: "macos"}, {name: "windows"}]}]},
	{name: "test other", description: "Other tests", implementations: [{script: {content: "echo other"}, runtimes: [{name: "virtual-sh"}], platforms: [{name: "linux"}, {name: "macos"}, {name: "windows"}]}]},
]

-- prefixleaf/invowkfile.cue --
cmds: [
	{name: "w2", description: "Leaf w2 from the invowkfile", implementations: [{script: {content: "echo w2"}, runtimes: [{name: "virtual-sh"}], platforms: [{name: "linux"}, {name: "macos"}, {name: "windows"}]}]},
]

-- prefixleaf/m.invowkmod/invowkmod.cue --
module: "m"
version: "1.0.0"
description: "M module"

-- prefixleaf/m.invowkmod/invowkfile.cue --
cmds: [
	{name: "w2 sub", description: "Child w2 sub from m", implementations: [{script: {content: "echo sub"}, runtimes: [{name: "virtual-sh"}], platforms: [{name: "linux"}, {name: "macos"}, {name: "windows"}]}]},
]
