# Test: directly rendered `invowk tui` components without any terminal
# (fix-tui-capture-output D1 step 3 and D3). Each run goes through
# `setsid -w`, so the process has no controlling terminal and a local run
# cannot open the developer's /dev/tty; testscript gives it a non-terminal
# stdin and captured stdout and stderr. Not a virtual test, so it needs no
# native mirror.

[!exec:setsid] skip 'setsid is needed to drop the controlling terminal'

cd $WORK
env NO_COLOR=1

# Test 1: value components fail with exit 1, name the component, and leave
# stdout empty.
exitcode 1 setsid -w invowk tui input --title Name
! stdout .
stderr 'Input needs a terminal'

exitcode 1 setsid -w invowk tui choose a b
! stdout .
stderr 'Choose needs a terminal'

exitcode 1 setsid -w invowk tui confirm 'Proceed?'
! stdout .
stderr 'Confirm needs a terminal'

# Test 2: spin runs the command without the spinner and keeps its stdout and
# exit status.
exitcode 3 setsid -w invowk tui spin --title Wait -- sh -c 'echo ok; exit 3'
stdout '^ok$'
! stderr 'needs a terminal'

# Test 3: spin runs the command exactly once.
exec setsid -w invowk tui spin -- sh -c 'echo run >>count.log'
cmp count.log want-count.log

# Test 4: pager writes the content unchanged to stdout and exits 0.
stdin pager-input.txt
exec setsid -w invowk tui pager
cmp stdout pager-input.txt
! stderr .

-- want-count.log --
run
-- pager-input.txt --
x
