# Test: directly rendered `invowk tui` components without any terminal
# (fix-tui-capture-output D1 step 3 and D3). Each run goes through the
# `notty` helper (tests/cli/notty_test.go): a new session on Unix, no console
# on Windows, so the process has no controlling terminal and a local run
# cannot open the developer's terminal. testscript gives it a non-terminal
# stdin and captured stdout and stderr. `tuiaction` is a portable spin
# command. Runs on Linux, macOS and Windows. Not a virtual test, so it needs
# no native mirror. Tests 5 and 6 cover the display-only rule of
# tui-clean-terminal-path (N15): with stdout not a terminal, `pager` and a
# non-selectable `table` write their content to stdout and exit 0.

cd $WORK
env NO_COLOR=1

# Test 1: value components fail with exit 1, name the component, and leave
# stdout empty.
exitcode 1 notty invowk tui input --title Name
! stdout .
stderr 'Input needs a terminal'

exitcode 1 notty invowk tui choose a b
! stdout .
stderr 'Choose needs a terminal'

exitcode 1 notty invowk tui confirm 'Proceed?'
! stdout .
stderr 'Confirm needs a terminal'

# A selectable table is a value component too, unlike a display table.
exitcode 1 notty invowk tui table --selectable --file rows.csv
! stdout .
stderr 'Table needs a terminal'

# Test 2: spin runs the command without the spinner and keeps its stdout and
# exit status.
exitcode 3 notty invowk tui spin --title Wait -- tuiaction first.log 3
stdout '^ok$'
cmp first.log want-count.log
! stderr 'needs a terminal'

# Test 3: spin runs the command exactly once.
exec notty invowk tui spin -- tuiaction count.log 0
cmp count.log want-count.log

# Test 4: pager writes the content unchanged to stdout and exits 0.
stdin pager-input.txt
exec notty invowk tui pager
cmp stdout pager-input.txt
! stderr .

# Test 5: pager with a title and line numbers still passes the bytes through.
stdin pager-input.txt
exec notty invowk tui pager --title Notes --line-numbers
cmp stdout pager-input.txt
! stderr .

# Test 6: a non-selectable table prints aligned plain-text rows and exits 0,
# from --file and from stdin with a custom separator.
exec notty invowk tui table --file rows.csv
cmp stdout want-table.txt
! stderr .

stdin rows-pipe.txt
exec notty invowk tui table --separator '|'
cmp stdout want-table.txt
! stderr .

# Test 7: plain-text cells stay on one line: a quoted CSV field with a newline
# prints the newline as a space, and so do format characters (U+202E, U+200B)
# and the line separator U+2028 (decisions 99 and 125.4).
exec notty invowk tui table --file rows-quoted.csv
cmp stdout want-quoted.txt
! stderr .

exec notty invowk tui table --file rows-format.csv
cmp stdout want-format.txt
! stderr .

-- want-count.log --
run
-- pager-input.txt --
x
-- rows.csv --
name,age,city
Alice,30,NYC
Bob,25,LA
-- rows-pipe.txt --
name|age|city
Alice|30|NYC
Bob|25|LA
-- want-table.txt --
name   age  city
Alice  30   NYC
Bob    25   LA
-- rows-quoted.csv --
name,notes
Alice,"line1
line2"
-- want-quoted.txt --
name   notes
Alice  line1 line2
-- rows-format.csv --
cell
a‮b​c d
-- want-format.txt --
cell
a b c d
