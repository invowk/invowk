# Test: cd and the file tests in virtual-sh, under restricted and full access
# (virtual-runtime-sandbox, "Restricted cd outside the allowed roots names the
# denial"). Inside the allowed roots, cd and test -f, [ -e ], [ -d ] and
# [[ -f ]] give the host shell's results and nothing panics. A restricted cd to
# a directory outside every allowed root fails and names the denial; the same
# cd under full access succeeds. [ -L ] is true for a link and false for its
# target. Mirrored by native_cd_file_tests.txtar.
#
# The outside directory must lie outside every allowed root. Off Windows /tmp
# is always a root and $WORK is normally below it, so the test uses /var/tmp.

[!windows] env OUTSIDE=/var/tmp
[windows] env OUTSIDE=$WORK/outside
[windows] mkdir $WORK/outside

cd $WORK/proj

# restricted access (the default): cd and the file tests inside the roots
exec invowk cmd cd-tests
stdout '[/\\]sub$'
stdout '^test-f: yes$'
stdout '^e: yes$'
stdout '^d: yes$'
stdout '^dbl-f: yes$'
stdout '^e-missing: no$'
! stderr 'panic|HandlerCtx'

# full access: the same results
exec invowk cmd cd-tests-full
stdout '[/\\]sub$'
stdout '^test-f: yes$'
stdout '^e: yes$'
stdout '^d: yes$'
stdout '^dbl-f: yes$'
stdout '^e-missing: no$'
! stderr 'panic|HandlerCtx'

# restricted access: cd outside every root is denied and says so
! exec invowk cmd cd-outside
stderr 'cd: virtual path denied'
! stdout 'after-cd'
! stderr 'panic|HandlerCtx'

# full access: the same cd succeeds
exec invowk cmd cd-outside-full
stdout '^after-cd$'
! stderr 'panic|HandlerCtx'

# [ -L ] tests the link itself: true for a link, false for its target
[symlink] symlink live -> target.txt
[symlink] exec invowk cmd link-tests
[symlink] stdout '^L-live: yes$'
[symlink] stdout '^L-target: no$'
[symlink] ! stderr 'panic|HandlerCtx'

-- proj/sub/file.txt --
content
-- proj/target.txt --
target
-- proj/invowkfile.cue --
cmds: [
	{
		name: "cd-tests"
		implementations: [{
			script: {content: """
				cd sub
				pwd
				test -f file.txt && echo "test-f: yes"
				[ -e file.txt ] && echo "e: yes"
				[ -d ../sub ] && echo "d: yes"
				[[ -f file.txt ]] && echo "dbl-f: yes"
				[ -e missing ] || echo "e-missing: no"
				"""}
			runtimes: [{name: "virtual-sh"}]
			platforms: [{name: "linux"}, {name: "macos"}, {name: "windows"}]
		}]
	},
	{
		name: "cd-tests-full"
		implementations: [{
			script: {content: """
				cd sub
				pwd
				test -f file.txt && echo "test-f: yes"
				[ -e file.txt ] && echo "e: yes"
				[ -d ../sub ] && echo "d: yes"
				[[ -f file.txt ]] && echo "dbl-f: yes"
				[ -e missing ] || echo "e-missing: no"
				"""}
			runtimes: [{name: "virtual-sh"}]
			platforms: [
				{name: "linux", virtual: {filesystem: {access: "full"}}},
				{name: "macos", virtual: {filesystem: {access: "full"}}},
				{name: "windows", virtual: {filesystem: {access: "full"}}},
			]
		}]
	},
	{
		name: "cd-outside"
		implementations: [{
			script: {content: """
				cd "$OUTSIDE" || exit 1
				echo after-cd
				"""}
			runtimes: [{name: "virtual-sh"}]
			platforms: [{name: "linux"}, {name: "macos"}, {name: "windows"}]
		}]
	},
	{
		name: "cd-outside-full"
		implementations: [{
			script: {content: """
				cd "$OUTSIDE" || exit 1
				echo after-cd
				"""}
			runtimes: [{name: "virtual-sh"}]
			platforms: [
				{name: "linux", virtual: {filesystem: {access: "full"}}},
				{name: "macos", virtual: {filesystem: {access: "full"}}},
				{name: "windows", virtual: {filesystem: {access: "full"}}},
			]
		}]
	},
	{
		name: "link-tests"
		implementations: [{
			script: {content: """
				[ -L live ] && echo "L-live: yes"
				[ -L target.txt ] || echo "L-target: no"
				"""}
			runtimes: [{name: "virtual-sh"}]
			platforms: [{name: "linux"}, {name: "macos"}, {name: "windows"}]
		}]
	},
]
